{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["sin1"],
  "functions": {
    "src/app/api/admin/boxhero-sync/route.ts": { "maxDuration": 60 },
    "src/app/api/admin/auto-categorize-products/route.ts": { "maxDuration": 60 },
    "src/app/api/admin/boxhero/sync/route.ts": { "maxDuration": 60 },
    "src/app/api/admin/boxhero/stock-chunk/route.ts": { "maxDuration": 60 },
    "src/app/api/orders/create/route.ts": { "maxDuration": 45 },
    "src/app/api/homepage-data/route.ts": { "maxDuration": 45 },
    "src/app/api/recommendations/route.ts": { "maxDuration": 45 },
    "src/app/api/analytics/queue-purchase/route.ts": { "maxDuration": 45 },
    "src/app/api/**/*.ts": { "maxDuration": 30 }
  },
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  },
  "headers": [
    {
      "source": "/api/auth/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0, private" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "Vary", "value": "Cookie, Authorization, Accept-Encoding" }
      ]
    },
    {
      "source": "/api/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0, private" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "Vary", "value": "Cookie, Authorization, Accept-Encoding" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=60, stale-while-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "crons": [
    {
      "path": "/api/admin/cron-process-email-queue",
      "schedule": "*/3 * * * *"
    },
    {
      "path": "/api/admin/cron-generate-recommendations",
      "schedule": "0 0 * * *"
    }
  ]
}
